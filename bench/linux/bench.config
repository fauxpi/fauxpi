# The benchmark's kernel: the Raspberry Pi kernel for the Pi Zero (BCM2835, ARM1176JZF-S), as
# small as boots to a vc4 display. Applied to `make tinyconfig` by bench/run.zig (--linux), which
# checks every option here took effect. Dazzle's kernel/dazzle.config and kernel/armv6.config,
# less what the benchmark doesn't use (USB, networking, storage, Wi-Fi, input, the camera).

# --- The platform: one ARMv6 core ---------------------------------------------------------------
# tinyconfig on ARM defaults to a no-MMU Cortex-M build.
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V6=y
# CONFIG_ARCH_MULTI_V7 is not set
# CONFIG_SMP is not set
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# The Raspberry Pi kernel's default, which tinyconfig turns off: DMA memory mapped non-cacheable
# rather than strongly ordered.
CONFIG_ARM_DMA_MEM_BUFFERABLE=y

# --- What init needs ------------------------------------------------------------------------------
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_TTY=y
CONFIG_FUTEX=y
# The 32-bit time system calls, which Zig's standard library uses on 32-bit ARM.
CONFIG_COMPAT_32BIT_TIME=y

# --- The serial console: the Zero's PL011 on GPIO 14 and 15 ---------------------------------------
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- The firmware, clocks, power domains, and the watchdog (which restarts the board: the end of a
# run) ---------------------------------------------------------------------------------------------
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM2835=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PM=y
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# HDMI's DDC (EDID) is on the BCM2835's I2C controller.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y

# --- vc4: the HVS and HDMI display, and the V3D ---------------------------------------------------
# The V3D has no MMU: its buffers come from CMA (cmdline.txt's cma=).
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# vc4 needs ALSA SoC (HDMI audio), and HDMI's audio needs the DMA engine to probe.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y
